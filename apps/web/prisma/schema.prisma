datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  FACULTY
  DEPARTMENT_APPROVER
  ADMINISTRATOR
}

enum ResourceCategory {
  CLASSROOM
  LAB
  SEMINAR_HALL
  MEETING_ROOM
  SPORTS
  EQUIPMENT
  VEHICLE
}

enum BookingStatus {
  PENDING
  APPROVED
  CONFIRMED
  REJECTED
  CANCELLED
  CHECKED_IN
  NO_SHOW
  COMPLETED
}

enum ActivityType {
  CLASS_LECTURE
  LAB_SESSION
  CLUB_EVENT
  PROJECT_WORK
  FACULTY_MEETING
  EXAM_EVALUATION
  SPORTS_PRACTICE
  GUEST_SEMINAR
}

enum PriorityLevel {
  NORMAL
  HIGH
  URGENT
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
}

enum WaitlistStatus {
  WAITING
  OFFERED
  EXPIRED
  FULFILLED
  WITHDRAWN
}

enum CheckInMethod {
  QR_TOKEN
  PIN
  APPROVER_OVERRIDE
  ADMIN_OVERRIDE
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  name              String
  role              Role           @default(STUDENT)
  regNo             String?
  department        String
  designation       String?
  phone             String?
  avatarUrl         String?
  isActive                Boolean                  @default(true)
  passwordChangedAt       DateTime?
  tokenVersion            Int                      @default(1)
  bookings                Booking[]
  bookingSeries           BookingSeries[]
  waitlistEntries         WaitlistEntry[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries  NotificationDelivery[]
  sessions                UserSession[]
  calendarFeeds           CalendarFeed[]
  auditLogs               AuditLog[]
  idempotencyKeys         IdempotencyKey[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Resource {
  id                 String           @id @default(uuid())
  code               String           @unique
  name               String
  category           ResourceCategory
  department         String
  building           String
  floor              String?
  capacity           Int              @default(30)
  amenities          String[]         @default([])
  imageUrl           String
  requiresApproval   Boolean          @default(false)
  isAvailableNow     Boolean          @default(true)
  isUnderMaintenance Boolean          @default(false)
  maintenanceReason  String?
  operatingHours          String           @default("08:00 AM - 08:00 PM")
  checkInSecretEncrypted  String?
  checkInSecretVersion    Int              @default(1)
  checkInSecretRotatedAt  DateTime?
  deletedAt               DateTime?
  bookings           Booking[]
  bookingSeries      BookingSeries[]
  waitlistEntries    WaitlistEntry[]
  timetableEntries   TimetableEntry[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([category])
  @@index([building])
  @@index([department])
  @@index([capacity])
  @@index([deletedAt])
}

model BookingSeries {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    Resource            @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  frequency   RecurrenceFrequency
  interval    Int                 @default(1)
  weekdays    String[]            @default([])
  startDate   DateTime
  until       DateTime?
  count       Int?
  timeOfDay   String
  duration    Int
  bookings    Booking[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([resourceId])
}

model Booking {
  id                 String         @id @default(uuid())
  bookingNumber      String         @unique
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId         String
  resource           Resource       @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  seriesId           String?
  series             BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  startTime          DateTime
  endTime            DateTime
  purpose            String
  activityType       ActivityType   @default(PROJECT_WORK)
  expectedAttendance Int            @default(1)
  priority           PriorityLevel  @default(NORMAL)
  status             BookingStatus  @default(PENDING)
  checkInToken            String?        @unique
  checkInPinHash          String?
  checkedInAt             DateTime?
  checkInMethod           CheckInMethod?
  checkedInById           String?
  checkInOverrideReason   String?
  venueVerified           Boolean        @default(false)
  checkInTokenJti         String?
  activeCheckInTokenJti   String?
  pinFailedAttempts       Int            @default(0)
  pinLockedUntil          DateTime?
  actualEndTime           DateTime?
  waitlistEntry      WaitlistEntry?
  releaseDeadline    DateTime?
  approvalNotes      String?
  rejectionReason    String?
  departmentId       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([resourceId, startTime, endTime])
  @@index([userId])
  @@index([status, startTime])
  @@index([status])
  @@index([seriesId])
}

model TimetableEntry {
  id             String   @id @default(uuid())
  resourceId     String
  resource       Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  courseCode     String
  courseName     String
  instructorName String
  dayOfWeek      Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime      String // "10:00"
  endTime        String // "12:00"
  department     String
  semester       String
  section        String
  createdAt      DateTime @default(now())

  @@index([resourceId, dayOfWeek])
  @@index([dayOfWeek, startTime, endTime])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("SYSTEM") // BOOKING, APPROVAL, REMINDER, CHECKIN, SYSTEM, WAITLIST, SECURITY
  read      Boolean   @default(false)
  readAt    DateTime?
  link      String?
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model DepartmentPolicy {
  id                         String   @id @default(uuid())
  department                 String   @unique
  maxAdvanceDays             Int      @default(14)
  maxBookingHoursPerWeek     Int      @default(20)
  requireFacultyEndorsement Boolean  @default(true)
  autoReleaseMinutes         Int      @default(15)
  autoApproveStudentHours    Int      @default(2)
  blackoutPeriods            String?  // JSON string
  updatedAt                  DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  userId       String
  requestHash  String
  statusCode   Int
  responseBody String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}

model WaitlistEntry {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId      String
  resource        Resource       @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  startTime       DateTime
  endTime         DateTime
  priority        Int            @default(0)
  status          WaitlistStatus @default(WAITING)
  offeredAt       DateTime?
  offerExpiresAt  DateTime?
  bookingId       String?        @unique
  booking         Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  withdrawnAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([resourceId, startTime, endTime])
  @@index([status, createdAt])
  @@index([offerExpiresAt])
  @@index([userId, createdAt])
  @@index([bookingId])
}

model ConsumedCheckInToken {
  id         String   @id @default(uuid())
  jti        String   @unique
  bookingId  String
  userId     String
  resourceId String
  expiresAt  DateTime
  consumedAt DateTime @default(now())

  @@index([bookingId])
  @@index([expiresAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationType    String
  emailEnabled        Boolean  @default(true)
  reminderLeadMinutes Int      @default(30)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, notificationType])
  @@index([userId])
}

model NotificationDelivery {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId        String?
  notificationType String
  scheduledFor     DateTime
  status           DeliveryStatus @default(PENDING)
  attemptCount     Int            @default(0)
  sentAt           DateTime?
  lastError        String?
  recipientEmail   String?
  subject          String?
  htmlBody         String?
  textBody         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([bookingId, notificationType, scheduledFor])
  @@index([status, scheduledFor])
  @@index([userId])
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  deviceLabel  String    @default("Unknown device")
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model CalendarFeed {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
}

