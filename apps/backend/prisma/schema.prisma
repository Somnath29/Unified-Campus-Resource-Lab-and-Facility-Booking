datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  FACULTY
  DEPARTMENT_APPROVER
  ADMINISTRATOR
}

enum ResourceCategory {
  CLASSROOM
  LAB
  SEMINAR_HALL
  MEETING_ROOM
  SPORTS
  EQUIPMENT
  VEHICLE
}

enum BookingStatus {
  PENDING
  NEEDS_INFO
  APPROVED
  CONFIRMED
  REJECTED
  CANCELLED
  CHECKED_IN
  NO_SHOW
  COMPLETED
}

enum ActivityType {
  CLASS_LECTURE
  LAB_SESSION
  CLUB_EVENT
  PROJECT_WORK
  FACULTY_MEETING
  EXAM_EVALUATION
  SPORTS_PRACTICE
  GUEST_SEMINAR
}

enum PriorityLevel {
  NORMAL
  HIGH
  URGENT
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role                 @default(STUDENT)
  regNo               String?
  department          String
  departmentId        String?
  departmentRel       Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation         String?
  phone               String?
  avatarUrl           String?
  bookings            Booking[]
  decidedBookings     Booking[]            @relation("BookingDecidedBy")
  bookingComments     BookingComment[]
  approvalDecisions   ApprovalDecision[]
  approverAssignments ApproverAssignment[]
  delegationsFrom     Delegation[]         @relation("DelegationsFrom")
  delegationsTo       Delegation[]         @relation("DelegationsTo")
  notifications       Notification[]
  auditLogs           AuditLog[]
  waitlistEntries     WaitlistEntry[]
  preemptionsInitiated PreemptionRecord[] @relation("PreemptionInitiatedBy")
  preemptionsAdminConfirmed PreemptionRecord[] @relation("PreemptionAdminConfirmedBy")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Department {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String               @unique
  users               User[]
  resources           Resource[]
  bookings            Booking[]
  approverAssignments ApproverAssignment[]
  delegations         Delegation[]
  departmentPolicies  DepartmentPolicy[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model ApproverAssignment {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
}

model Resource {
  id                 String           @id @default(uuid())
  code               String           @unique
  name               String
  category           ResourceCategory
  department         String
  departmentId       String?
  departmentRel      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  building           String
  floor              String?
  capacity           Int              @default(30)
  amenities          String[]         @default([])
  imageUrl           String
  requiresApproval   Boolean          @default(false)
  isAvailableNow     Boolean          @default(true)
  isUnderMaintenance Boolean          @default(false)
  maintenanceReason  String?
  operatingHours     String           @default("08:00 AM - 08:00 PM")
  bookings           Booking[]
  timetableEntries   TimetableEntry[]
  waitlistEntries    WaitlistEntry[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Booking {
  id                 String             @id @default(uuid())
  bookingNumber      String             @unique
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId         String
  resource           Resource           @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startTime          DateTime
  endTime            DateTime
  purpose            String
  activityType       ActivityType       @default(PROJECT_WORK)
  expectedAttendance Int                @default(1)
  priority           PriorityLevel      @default(NORMAL)
  status             BookingStatus      @default(PENDING)
  checkInToken       String?            @unique
  checkedInAt        DateTime?
  releaseDeadline    DateTime?
  approvalNotes      String?
  rejectionReason    String?
  departmentId       String?
  department         Department?        @relation(fields: [departmentId], references: [id])
  submittedAt        DateTime           @default(now())
  decidedAt          DateTime?
  decidedById        String?
  decidedBy          User?              @relation("BookingDecidedBy", fields: [decidedById], references: [id])
  slaDueAt           DateTime?
  comments           BookingComment[]
  approvalDecisions  ApprovalDecision[]
  waitlistEntries    WaitlistEntry[]
  preemptedAsTarget  PreemptionRecord[] @relation("PreemptionTargetBooking")
  preemptedAsBumped  PreemptionRecord[] @relation("PreemptionBumpedBooking")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([resourceId, startTime, endTime])
  @@index([status])
}

model BookingComment {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@index([authorId])
}

model Delegation {
  id           String     @id @default(uuid())
  fromUserId   String
  fromUser     User       @relation("DelegationsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User       @relation("DelegationsTo", fields: [toUserId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([departmentId, startsAt, endsAt])
}

model ApprovalDecision {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  approverId String
  approver   User     @relation(fields: [approverId], references: [id], onDelete: Cascade)
  action     String
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@index([approverId])
}

model TimetableEntry {
  id             String   @id @default(uuid())
  resourceId     String
  resource       Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  courseCode     String
  courseName     String
  instructorName String
  dayOfWeek      Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime      String // "10:00"
  endTime        String // "12:00"
  department     String
  semester       String
  section        String
  createdAt      DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // BOOKING, APPROVAL, REMINDER, CHECKIN, SYSTEM
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model DepartmentPolicy {
  id                        String      @id @default(uuid())
  department                String      @unique
  departmentId              String?
  departmentRel             Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  maxAdvanceDays            Int         @default(14)
  maxBookingHoursPerWeek    Int         @default(20)
  requireFacultyEndorsement Boolean     @default(true)
  autoReleaseMinutes        Int         @default(15)
  autoApproveStudentHours   Int         @default(2)
  blackoutPeriods           String? // JSON string
  approvalSlaHours          Int         @default(24)
  escalateToRole            Role?
  updatedAt                 DateTime    @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  details    String?
  createdAt  DateTime @default(now())
}

enum PreemptionStatus {
  PENDING_ADMIN_CONFIRMATION
  COMPLETED
  REJECTED
  UNDONE
}

model PreemptionRecord {
  id                             String           @id @default(uuid())
  targetBookingId                String
  targetBooking                  Booking          @relation("PreemptionTargetBooking", fields: [targetBookingId], references: [id], onDelete: Cascade)
  bumpedBookingId                String
  bumpedBooking                  Booking          @relation("PreemptionBumpedBooking", fields: [bumpedBookingId], references: [id], onDelete: Cascade)
  initiatorId                    String
  initiator                      User             @relation("PreemptionInitiatedBy", fields: [initiatorId], references: [id], onDelete: Cascade)
  reason                         String
  requiresAdminConfirmation        Boolean          @default(false)
  adminApproverId                String?
  adminApprover                  User?            @relation("PreemptionAdminConfirmedBy", fields: [adminApproverId], references: [id], onDelete: SetNull)
  adminConfirmedAt               DateTime?
  status                         PreemptionStatus @default(COMPLETED)
  canUndoUntil                   DateTime?
  undoneAt                       DateTime?
  undoneById                     String?
  undoReason                     String?
  bumpedOriginalCheckInToken     String?
  bumpedOriginalReleaseDeadline DateTime?
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  @@index([targetBookingId])
  @@index([bumpedBookingId])
  @@index([status])
}

model WaitlistEntry {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  priority   Int      @default(0) // Higher = served first (e.g., 100 for bumped bookings)
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([resourceId, priority])
  @@index([userId])
}
