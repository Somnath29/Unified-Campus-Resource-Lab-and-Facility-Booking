{
  "name": "lpu-campus-resource-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,WEB,ADMIN\" -c \"yellow,blue,magenta\" \"npm run dev:backend\" \"npm run dev:web\" \"npm run dev:admin\"",
    "dev:backend": "npm run dev --prefix apps/backend",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:admin": "npm run dev --prefix apps/admin",
    "build": "npm run build --workspaces",
    "db:migrate": "npm run db:migrate --prefix apps/backend",
    "db:seed": "npm run db:seed --prefix apps/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

