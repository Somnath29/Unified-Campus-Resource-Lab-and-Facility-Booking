{
  "name": "lpu-campus-resource-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"WEB,ADMIN\" -c \"blue,magenta\" \"npm run dev:web\" \"npm run dev:admin\"",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:admin": "npm run dev --prefix apps/admin",
    "build": "npm run build --prefix apps/web && npm run build --prefix apps/admin",
    "db:migrate": "npm run db:migrate --prefix apps/web",
    "db:push": "npm run db:push --prefix apps/web",
    "db:seed": "npm run db:seed --prefix apps/web",
    "db:studio": "npm run db:studio --prefix apps/web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
